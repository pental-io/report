# Pental Report's settings. The installer (or setup.sh / setup.ps1) writes
# .env with the first block filled in; everything after it is optional.
#
# SPDX-License-Identifier: AGPL-3.0-only

# ── Made by setup ───────────────────────────────────────────────────────────
# The PostgreSQL superuser, used only by the database container itself.
POSTGRES_PASSWORD=
# The ordinary role Pental Report's server connects as. Read when the
# database is first made; changing it afterwards needs ALTER ROLE too.
REPORT_DB_PASSWORD=
# Signs every sign-in. At least 32 characters.
JWT_SECRET=
# Encrypts the secrets kept in the database (your AI key, this server's
# signing keys). At least 32 characters. Lose it and they cannot be read.
VAULT_KEY=
# Asked for once, to make the first administrator.
SETUP_TOKEN=
# The address your team types to open Pental Report, with no path. The
# installer fills it in: http://localhost:8080 on one computer, your
# Tailscale address (https://<computer>.<tailnet>.ts.net) with --tailscale, or
# https://your-domain. Password links and security keys are made for it.
PUBLIC_URL=http://localhost:8080
# With a domain, Caddy serves HTTPS for it (COMPOSE_PROFILES=https).
DOMAIN=
COMPOSE_PROFILES=
# How many proxies sit in front of Pental Report: 1 behind Caddy or
# Tailscale's, false with none.
TRUST_PROXY=false
# 1 when the installer shares it on your tailnet (tailscale serve), so an
# update shares it again at the same address.
TAILSCALE=

# ── Where it listens without Caddy ──────────────────────────────────────────
# 127.0.0.1 keeps it to this machine. Browsers only allow some of what the
# app does on https or on localhost, so share it with a team over Tailscale
# or through a domain rather than a bare IP address.
BIND_ADDRESS=127.0.0.1
PORT=8080

# ── Version ─────────────────────────────────────────────────────────────────
# The release the app's image is fetched for. The installer sets it when it
# updates; by hand, it is the version in server/package.json.
# REPORT_VERSION=0.1.6

# ── Updates ─────────────────────────────────────────────────────────────────
# Pental Report asks GitHub for its latest release twice a day, so an
# administrator is told when there is a newer one (Settings, Updates). The
# request carries nothing but this server's version. off stops it.
UPDATE_CHECK=on
# The updater on this computer (update.sh, run every minute by a systemd timer
# or a launchd agent the installer sets up) asks with this whether to update,
# and installs a new release when an administrator presses Update Now, or
# overnight. Made by setup and the installer.
UPDATE_TOKEN=
# 0 turns the updater off (as the installer's --no-auto-update does).
UPDATER=
# What the installer says of this computer, so the app gives the exact
# command that updates it: linux, macos or windows; the folder it lives in;
# and 1 when it was installed as root.
REPORT_HOST=
REPORT_DIR=
REPORT_ROOT=

# ── Files ───────────────────────────────────────────────────────────────────
# Evidence, templates and reports are kept in the database unless you choose
# an S3-compatible bucket (AWS S3, MinIO, Cloudflare R2, Backblaze B2).
STORAGE_BACKEND=postgres
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Largest single upload, in MB.
MAX_UPLOAD_MB=50

# ── Logs ────────────────────────────────────────────────────────────────────
# debug, info, warn or error.
LOG_LEVEL=info
